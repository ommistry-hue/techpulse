# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order, then OpenRouter models in order
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Free key: https://openrouter.ai/keys  (fallback when Gemini hits limits)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,thinkingmachines/inkling:free

# Real photos from Wikimedia Commons (no key needed, credits auto-added to description). 1=on 0=off
USE_WIKIMEDIA=1
# Optional stock VIDEO clips (either or both), used before photos when set.
# Free key: log in at https://pixabay.com, key shown at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels (new keys currently paused): https://www.pexels.com/api/
PEXELS_API_KEY=

# Trends country code (US, IN, GB, ...)
GEO=US
# Niche/industry focus, e.g. tech, finance, sports. Blank = most viral trend overall.
NICHE=

# Which videos to make daily: long (3-5 min, 16:9), short (~50s, 9:16 Shorts/Reels)
FORMATS=long,short

TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+10%

# public | unlisted | private
YT_PRIVACY=public
# 25=News & Politics, 24=Entertainment, 28=Science & Tech, 17=Sports
YT_CATEGORY=25
